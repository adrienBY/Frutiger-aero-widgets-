<?xml version="1.0" encoding="utf-8"?>
<!-- Layers: scene background, rising bubbles (30 frames cycled by a ViewFlipper at
     10 fps, the same 3 s loop as the Aqua Orb clock), then text + gloss. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/weather_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="@string/weather_name">

    <ImageView
        android:id="@+id/weather_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/wx_clear_d" />

    <ViewFlipper
        android:id="@+id/bubbles"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:autoStart="true"
        android:flipInterval="100">
